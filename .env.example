# Telegram bot token (required)
PRAKTOR_TELEGRAM_TOKEN=

# ADK / vLLM model backend
# auto = use ADK when vLLM/Gemini env is present, otherwise Claude SDK when Claude auth is present
AGENT_BACKEND=auto

# Use an OpenAI-compatible vLLM endpoint:
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=vllm/gemma4-12b

# Or use Google ADK/Gemini:
ADK_MODEL=
GEMINI_API_KEY=
#GOOGLE_API_KEY=
#GOOGLE_GENAI_USE_VERTEXAI=false
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=

# Claude SDK fallback when no vLLM/Gemini env is configured
ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=
# Set true only if this image should include the Claude Code binary for Claude SDK fallback.
INSTALL_CLAUDE_CODE=false
# Set true only if you need agentmail-cli and vector memory embeddings in the agent image.
INSTALL_AGENT_EXTRAS=false

# Mission Control password (optional)
PRAKTOR_WEB_PASSWORD=

# Vault passphrase for encrypted secrets (required)
PRAKTOR_VAULT_PASSPHRASE=

# OpenAI API key for voice transcription (STT) and synthesis (TTS) (optional)
OPENAI_API_KEY=

# Log analyzer API endpoint. Store the bearer token in Praktor vault as log-api-key.
LOG_API_URL=https://integrate.insky.io.vn/int/gw/v1/report/waf/event/secs-engine

# Reporter analytics APIs. Uses the same vault bearer token secret: log-api-key.
REPORT_BANDWIDTH_API_URL=https://bo.insky.io.vn/api/eco/analytic/report/bandwidth
REPORT_REQUEST_API_URL=https://bo.insky.io.vn/api/eco/analytic/report

# GitLab code reader. Token is forwarded only to the code_reader agent.
GITLAB_DOMAIN=
GITLAB_TOKEN=
GITLAB_USERNAME=oauth2

# Optional host mappings injected into every agent container, useful when
# internal GitLab DNS is only resolvable on the Docker host.
# Format: hostname:ip,hostname2:ip2
PRAKTOR_AGENT_EXTRA_HOSTS=

# Timezone (optional, default: UTC)
TZ=UTC

# Docker group ID for socket access (required for non-root container user)
DOCKER_GID=
PRAKTOR_RUN_USER=0:0
PRAKTOR_DOCKER_NETWORK=fork-praktor-net

# Go module proxy used during Docker builds (optional)
GOPROXY=https://proxy.golang.org,direct

# Tailscale reverse proxy (optional, for production deployment)
#HOSTNAME=praktor
#TS_AUTHKEY=tskey-auth-...
